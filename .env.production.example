APP_NAME=KawalBelajar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db_production
DB_PORT=3306
DB_DATABASE=kawalbelajar_production
DB_USERNAME=kb_production
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# Isi hanya dengan secret key Xendit live dan callback token production.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
GA4_MEASUREMENT_ID=

# Kredensial bootstrap seeder; ganti dengan alamat dan password unik yang kuat.
ADMIN_INITIAL_EMAIL=admin@kawalbelajar.id
ADMIN_INITIAL_NAME=Administrator KawalBelajar
ADMIN_INITIAL_PASSWORD=

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@kawalbelajar.id
MAIL_FROM_NAME="KawalBelajar"
