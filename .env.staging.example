APP_NAME=KawalBelajar
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db_staging
DB_PORT=3306
DB_DATABASE=kawalbelajar_staging
DB_USERNAME=kb_staging
