# Gunakan secret key Xendit mode development/sandbox khusus UAT.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
